        {
          "name": "01 Aplicar Descuento ECO20",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Status code 200 \r\npm.test('status 200', () => pm.response.to.have.status(200));\r\n// ECO20 = 20% de descuento: 100 -> 80\r\npm.test('discount applied', () => pm.expect(pm.response.json().discount_applied).to.eql('20%'));\r\n// Final price after discount: 100 - 20 = 80\r\npm.test('final price', () => pm.expect(pm.response.json().final_price).to.eql(80));\r\n\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"price\": 100,\n    \"coupon\": \"ECO20\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{URL}}/discount",
              "host": [
                "{{URL}}"
              ],
              "path": [
                "discount"
              ]
            }
          },
          "response": []
        },
